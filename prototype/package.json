{
  "name": "protokit-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A product prototype on a simulated server, tied to its docc documents.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen": "graphql-codegen --config codegen.yml",
    "docs": "node scripts/proto-docs.mjs",
    "predev": "npm run docs && npm run gen",
    "prebuild": "npm run docs && npm run gen",
    "precheck": "npm run docs && npm run gen",
    "check": "biome check && tsc --noEmit",
    "lint:fix": "biome check --write",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run docs && npm run gen"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "urql": "^5.0.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "~8.1.5"
  }
}
